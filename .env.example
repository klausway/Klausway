# ─── Local development (recommended for editing Blog / Portfolio / Team) ───
# Run: npm run db:setup:local
# Then keep these values in .env while developing on your laptop.
DATABASE_URL="postgresql://USER@localhost:5432/klausway_website"
UPLOAD_DRIVER="local"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Localhost is ignored for canonical / og:url / sitemap — those always use
# https://www.klausway.com unless this is a real public URL (e.g. GitHub Pages).
# Production (Vercel): set NEXT_PUBLIC_SITE_URL="https://www.klausway.com"
# or leave it unset. Never set a localhost value on Vercel.

# ─── Production / remote Postgres (optional) ───
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/klausway_website"
# UPLOAD_DRIVER="s3"

# AWS S3 File Storage (required when UPLOAD_DRIVER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=us-east-1
S3_BUCKET_NAME=kw-doc
S3_DOCUMENTS_PREFIX=klausway_website/

# Email (Resend) — required for /api/contact
# Production must set these on Vercel. The contact endpoint includes abuse
# protection (reCAPTCHA v3, honeypot, min submit time, field limits,
# per-IP/email rate limit) plus a Vercel Firewall rate limit on POST /api/contact.
RESEND_API_KEY=""
NOTIFICATION_FROM="noreply@kwapp.io"
CONTACT_TO="support@klausway.com"

# Shared secret so the WorkNex product site (klaus-connect.com) can POST
# leads into /api/contact without reCAPTCHA. Generate a long random string
# and set the SAME value on both Vercel projects (Klausway + WorkNex landing).
CONTACT_INGEST_SECRET=""

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Create a v3 key for your domains (localhost + klausway.com / www.klausway.com).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Admin CMS
ADMIN_SECRET="change-me-to-a-strong-password"
JWT_SECRET="change-me-to-a-strong-jwt-secret"

# Vapi chat widget (client-side, publishable keys — must be NEXT_PUBLIC_*)
# Used by components/vapi-chat-widget.tsx. Optional overrides; the component
# ships with Klaus Way defaults so the chatbot still renders when these are blank.
# Mode: chat | voice | hybrid
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
NEXT_PUBLIC_VAPI_MODE="chat"

# Vapi end-of-call notifications (POST /api/vapi/webhook/)
# Set the same value as the Server URL secret in the Vapi dashboard. The route
# rejects every request when this is blank, so leave it empty to keep the
# webhook disabled. Emails go to CALL_NOTIFY_TO, falling back to CONTACT_TO.
# Note: end-of-call reports only fire for voice calls, not text chat.
VAPI_WEBHOOK_SECRET=""
CALL_NOTIFY_TO=""

# Cal.com booking embed (https://cal.com) — e.g. "klausway/intro-call".
# Leave blank to hide the booking embed on /contact and the thank-you screen.
NEXT_PUBLIC_CAL_LINK=""

# Google Analytics 4 (https://analytics.google.com)
# GA4 stream ID from Admin → Data streams → Web.
# Optional override; the site defaults to G-6KDFEV8EQK when this is blank.
NEXT_PUBLIC_GA_ID="G-6KDFEV8EQK"

# n8n Daily Article Curator (scripts/create-n8n-daily-curator.js)
# n8n_url (or N8N_BASE_URL) and n8n_api_key point the script at your n8n
# instance. GNEWS_API_KEY (https://gnews.io) is injected into the workflow
# when the script pushes it. If you instead import
# scripts/n8n-daily-article-workflow.json by hand, set GNEWS_API_KEY in the
# n8n instance environment — that node reads $env.GNEWS_API_KEY.
n8n_url=""
n8n_api_key=""
GNEWS_API_KEY=""

# SEO / Open Graph (canonical site URL, no trailing slash)
# Production example: https://www.klausway.com
# GitHub Pages example: https://kotchamon-20.github.io/Klausway
# NEXT_PUBLIC_SITE_URL="https://www.klausway.com"

# Search engine ownership verification (meta tag content only, not the full tag).
# Google Search Console → HTML tag method; Bing Webmaster Tools → meta tag method.
# Leave blank to omit the tags. After deploying, submit /sitemap.xml in both consoles.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Weekly SEO Monitor (n8n workflow: Klausway — Weekly SEO Monitor)
# Default report recipient is support@klausway.com (Config node). Set this on the
# n8n host only if you need a different inbox without editing the workflow.
# SEO_REPORT_TO="support@klausway.com"
# After creating a Google OAuth credential with webmasters.readonly in n8n,
# set its id so scripts/create-n8n-seo-weekly-report.js can wire GSC calls:
# GSC_N8N_CREDENTIAL_ID=""
# Setup guide: scripts/SEO_WEEKLY_REPORT_SETUP.md
