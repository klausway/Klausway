# ─── Local development (recommended for editing Blog / Portfolio / Team) ───
# Run: npm run db:setup:local
# Then keep these values in .env while developing on your laptop.
DATABASE_URL="postgresql://USER@localhost:5432/klausway_website"
UPLOAD_DRIVER="local"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Production / remote Postgres (optional) ───
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/klausway_website"
# UPLOAD_DRIVER="s3"

# AWS S3 File Storage (required when UPLOAD_DRIVER=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=us-east-1
S3_BUCKET_NAME=kw-doc
S3_DOCUMENTS_PREFIX=klausway_website/

# Email (Resend) — required for /api/contact
# Production must set these on Vercel. The contact endpoint includes abuse
# protection (reCAPTCHA v3, honeypot, min submit time, field limits,
# per-IP/email rate limit) plus a Vercel Firewall rate limit on POST /api/contact.
RESEND_API_KEY=""
NOTIFICATION_FROM="noreply@kwapp.io"
CONTACT_TO="support@klausway.com"

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Create a v3 key for your domains (localhost + klausway.com / www.klausway.com).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Admin CMS
ADMIN_SECRET="change-me-to-a-strong-password"
JWT_SECRET="change-me-to-a-strong-jwt-secret"

# Vapi chat widget (client-side, publishable keys — must be NEXT_PUBLIC_*)
# Used by components/vapi-chat-widget.tsx. Optional overrides; the component
# ships with Klaus Way defaults so the chatbot still renders when these are blank.
# Mode: chat | voice | hybrid
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
NEXT_PUBLIC_VAPI_MODE="chat"

# Google Analytics 4 (https://analytics.google.com)
# Measurement ID from Admin → Data streams → Web. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# SEO / Open Graph (canonical site URL, no trailing slash)
# Production example: https://www.klausway.com
# GitHub Pages example: https://kotchamon-20.github.io/Klausway
# NEXT_PUBLIC_SITE_URL="https://www.klausway.com"
