generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  CONTENT
}

enum ResourceType {
  ARTICLE
  GUIDE
  NEWS
  CASE_STUDY
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(CONTENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BlogPost {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  excerpt         String
  content         String       @db.Text
  type            ResourceType @default(ARTICLE)
  coverImage      String?
  galleryImages   String[]     @default([])
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  published       Boolean      @default(false)
  date            DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// Written by the n8n Daily Article Curator to dedupe source URLs.
model N8nArticleCandidate {
  id         String   @id
  url        String   @unique
  title      String?
  slug       String?
  status     String   @default("proposed")
  sourceFeed String?  @map("source_feed")
  coverImage String?  @map("cover_image")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@map("n8n_article_candidates")
}

/// Weekly SEO Monitor report history (idempotent on execution_id).
model N8nSeoReport {
  id                  String   @id
  executionId         String   @unique @map("execution_id")
  reportDate          DateTime @map("report_date") @db.Date
  sites               String[]
  periodStart         DateTime @map("period_start") @db.Date
  periodEnd           DateTime @map("period_end") @db.Date
  metricsJson         Json     @map("metrics_json")
  issuesJson          Json     @map("issues_json")
  recommendationsJson Json     @map("recommendations_json")
  status              String
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("n8n_seo_reports")
}

/// Dedupes urgent SEO alerts until the issue is resolved.
model N8nSeoAlertState {
  id            String    @id @default(cuid())
  issueKey      String    @unique @map("issue_key")
  siteId        String    @map("site_id")
  severity      String
  lastAlertedAt DateTime? @map("last_alerted_at")
  resolvedAt    DateTime? @map("resolved_at")
  detailsJson   Json?     @map("details_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([siteId])
  @@map("n8n_seo_alert_state")
}

/// Last seen robots.txt hash per site for change detection.
model N8nSeoRobotsSnapshot {
  siteId     String   @id @map("site_id")
  robotsHash String   @map("robots_hash")
  robotsText String   @map("robots_text") @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("n8n_seo_robots_snapshots")
}

model PortfolioProject {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  overview      String   @db.Text
  coverImage    String?
  galleryImages String[] @default([])
  categories    String[]
  tags          String[]
  accent        String   @default("from-cyan-400 to-blue-500")
  keyFeatures   String[]
  benefits      String[]
  useCases      String[]
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactSubmission {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String     @db.Text
  source    String? // e.g. "contact", "product:dineassist"
  intent    String? // "demo" | "consult" | "custom" | "other"
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model QrCode {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  destination   String
  active        Boolean   @default(true)
  scanCount     Int       @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  role      String
  image     String?
  /// Paragraphs; entries starting with "## " are section headings.
  bio       String[] @default([])
  initials  String
  accent    String   @default("from-brand-500 to-violet-600")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
