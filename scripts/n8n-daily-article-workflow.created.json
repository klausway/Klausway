    {
      "id": "normalize",
      "name": "Normalize Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        380
      ],
      "parameters": {
        "jsCode": "const out = [];\nconst seen = new Set();\n\nfunction add(url, title, description, image, source) {\n  if (!url || !title) return;\n  const clean = String(url).trim();\n  if (!clean.startsWith('http') || seen.has(clean)) return;\n  seen.add(clean);\n  out.push({\n    url: clean,\n    title: String(title).trim().slice(0, 300),\n    description: String(description || '').trim().slice(0, 800),\n    image: image ? String(image) : '',\n    source: source || 'unknown',\n  });\n}\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (Array.isArray(j.articles)) {\n    for (const a of j.articles) {\n      add(a.url, a.title, a.description || a.content, a.image, 'gnews');\n    }\n  }\n  if (j.link || j.url) {\n    add(\n      j.link || j.url,\n      j.title,\n      j.contentSnippet || j.content || j.description,\n      (j.enclosure && j.enclosure.url) || '',\n      'google-news-rss',\n    );\n  }\n}\n\nif (!out.length) {\n  return [{ json: { empty: true, candidates: [], message: 'No articles fetched' } }];\n}\nreturn [{ json: { empty: false, candidates: out.slice(0, 30) } }];"
      }
    },
    {
      "id": "load-used",
      "name": "Load Used URLs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        380
      ],
      "credentials": {
        "postgres": {
          "id": "gkDTjnaiYMJ6dDdr",
          "name": "Klausway Website Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT url FROM n8n_article_candidates;",
        "options": {}
      }
    },
    {
      "id": "filter-unused",
      "name": "Filter Unused",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        380
      ],
      "parameters": {
        "jsCode": "const used = new Set(\n  $input.all().map((i) => String(i.json.url || '')).filter(Boolean),\n);\nconst candidates = $('Normalize Candidates').first().json.candidates || [];\nconst fresh = candidates.filter((c) => !used.has(c.url)).slice(0, 12);\n\nif (!fresh.length) {\n  return [{ json: { empty: true, message: 'All candidates already used', candidates: [] } }];\n}\nreturn [{ json: { empty: false, candidates: fresh } }];"
      }
    },
