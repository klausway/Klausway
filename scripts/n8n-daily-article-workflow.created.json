    {
      "id": "merge-feeds",
      "name": "Merge Feeds",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        960,
        380
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
