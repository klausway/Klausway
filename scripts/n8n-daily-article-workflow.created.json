      "parameters": {
        "jsCode": "const article = $('Parse Rewrite').first().json;\nconst s3 = $input.first().json;\nconst key =\n  s3.Key ||\n  s3.key ||\n  s3.fileName ||\n  ('klausway_website/resources/' + article.slug + '.jpg');\nconst coverImage =\n  s3.Location ||\n  s3.location ||\n  ('https://kw-doc.s3.us-east-1.amazonaws.com/' + String(key).replace(/^\\/+/, ''));\n\nreturn [{\n  json: {\n    ...article,\n    coverImage,\n    s3Key: key,\n  },\n}];"
      }
    },
